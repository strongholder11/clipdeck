<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClipDeck</AssemblyName>
    <ApplicationIcon>Assets/clipdeck.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>ClipDeck</Product>
    <Company>ClipDeck</Company>
    <!-- Sem símbolos de depuração no pacote: eram 100 MB de .pdb junto do app. -->
    <DebugType>none</DebugType>
    <!-- Impede que os .pdb das dependências nativas (Skia, HarfBuzz) sejam
         copiados: são 100 MB de símbolos que ninguém vai depurar. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClipDeck.Core\ClipDeck.Core.csproj" />
  </ItemGroup>
</Project>
